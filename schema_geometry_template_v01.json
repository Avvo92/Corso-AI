{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema_geometry_template_v01.json",
  "title": "Geometry Template v0.1 - Replicator PDF",
  "description": "Contratto layout per rigenerazione PDF fedele per doc_type_id.",
  "type": "object",
  "required": [
    "doc_type_id",
    "version",
    "page_size_pt",
    "render_strategy",
    "metadata_policy",
    "zones"
  ],
  "properties": {
    "doc_type_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificativo univoco del tipo documento / emittente"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+)*$",
      "description": "Versione template (es. v1, v1.1)"
    },
    "software_emittente": {
      "type": "string"
    },
    "page_size_pt": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "description": "Larghezza e altezza pagina in punti tipografici"
    },
    "render_strategy": {
      "type": "string",
      "enum": ["fill_master", "overlay", "reportlab"]
    },
    "master_pdf_path": {
      "type": "string",
      "description": "Path relativo al master per strategia fill_master (non committare PDF sensibili)"
    },
    "metadata_policy": {
      "type": "object",
      "required": ["creator", "producer", "allow_spoofing_third_party"],
      "properties": {
        "creator": { "type": "string" },
        "producer": { "type": "string" },
        "pdf_version_target": { "type": "string" },
        "allow_spoofing_third_party": {
          "type": "boolean",
          "const": false,
          "description": "Deve restare false: vietato imitare Producer/Creator di software terzi"
        }
      },
      "additionalProperties": false
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Zone" }
    },
    "tables": {
      "type": "array",
      "items": { "$ref": "#/$defs/TableConfig" }
    }
  },
  "$defs": {
    "BBox": {
      "type": "object",
      "required": ["x0", "y0", "x1", "y1"],
      "properties": {
        "x0": { "type": "number" },
        "y0": { "type": "number" },
        "x1": { "type": "number" },
        "y1": { "type": "number" },
        "unit": { "type": "string", "enum": ["pt"], "default": "pt" }
      },
      "additionalProperties": false
    },
    "Zone": {
      "type": "object",
      "required": ["zone_id", "kind", "bbox"],
      "properties": {
        "zone_id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["text", "table", "image", "line", "rect"]
        },
        "bbox": { "$ref": "#/$defs/BBox" },
        "page_index": { "type": "integer", "minimum": 0, "default": 0 },
        "font": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "size_pt": { "type": "number" },
            "color_hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          }
        },
        "tolerance_pt": {
          "type": "number",
          "minimum": 0,
          "default": 3,
          "description": "Tolleranza allineamento cross-corpus"
        }
      },
      "additionalProperties": false
    },
    "TableConfig": {
      "type": "object",
      "required": ["table_id", "zone_id", "col_widths_pt"],
      "properties": {
        "table_id": { "type": "string" },
        "zone_id": { "type": "string" },
        "col_widths_pt": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 1
        },
        "header_rows": { "type": "integer", "minimum": 0, "default": 1 },
        "dynamic_rows": { "type": "boolean", "default": true },
        "row_height_pt": { "type": "number" },
        "pagination": {
          "type": "object",
          "properties": {
            "max_rows_per_page": { "type": "integer", "minimum": 1 },
            "repeat_header": { "type": "boolean", "default": true }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
