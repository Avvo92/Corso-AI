{
  "schema_version": "v01",
  "doc_type_id": "busta_paga",
  "description": "Profili mutazione lab — canone CANONE_STRESS_TEST_LAB_VR.md",
  "defaults": {
    "export_mode": "stress_test",
    "metadata_profile": "mimic_y",
    "template_id": "zucchetti_v3_cluster_a"
  },
  "metadata_profiles": {
    "mimic_y": {
      "description": "Metadati PDF coerenti con export Zucchetti del cluster train — NESSUNA stringa Replicator nel PDF",
      "forbid_strings_in_pdf": ["Replicator", "replicator_run", "Generated by Corso IA"],
      "mimic_fields": ["Creator", "Producer", "CreationDate"]
    }
  },
  "profiles": [
    {
      "stress_profile_id": "realistic_full",
      "description": "Default stress test: meta mimic Y + mutazione numerica credibile (totali coerenti)",
      "mutation": { "fields": ["netto", "lordo"], "strategy": "coherent_compute" },
      "weight_in_batch": 0.7
    },
    {
      "stress_profile_id": "lazy_fraud",
      "description": "Baseline: solo netto in evidenza, dettaglio non aggiornato",
      "mutation": { "fields": ["netto"], "strategy": "scale_or_replace" },
      "weight_in_batch": 0.2
    },
    {
      "stress_profile_id": "visual_micro",
      "description": "P2: patch allowlist — raro",
      "mutation": { "fields": [], "strategy": "patch_allowlist" },
      "weight_in_batch": 0.1
    }
  ]
}
